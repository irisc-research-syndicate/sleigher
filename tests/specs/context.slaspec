# Context variables, little endian, fixed 32-bit instructions.
#
#   mode   flows: selects the meaning of op 1 (add in mode 0, sub in mode 1).
#          `mode0`/`mode1` switch it from the next instruction on.
#   shift  noflow: set by the `pfx` prefix for the next instruction only, read
#          by `shl` in its display and semantics, and compared by `lo`/`hi`.
#   width  set by `mov` for its operand subtable, which decodes a register
#          (width=0) or an immediate (width=1).
#   bank   selects the register `inc` works on through an attach.
#
# `jm1` jumps and switches mode to 1 at its destination with a globalset to
# that address. `jt1` and `jr1` do the same with a globalset to the table that
# exports the destination, absolute or relative to inst_next, and `ms1` to the
# SRC table, which commits only where SRC exports a constant, not a register.
# `re1` reassigns its globalset address afterwards, which Ghidra rejects; the
# commit goes to the address at the globalset.

define endian=little;
define alignment=4;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [ r0 r1 r2 r3 r4 r5 r6 r7 ];
define register offset=0x100 size=4 contextreg;

define context contextreg
    mode=(0, 0)
    shift=(1, 2) noflow
    width=(3, 3) noflow
    bank=(4, 4)
;

define token instr(32)
    op=(24, 31)
    rd=(20, 22)
    imm_flag=(19, 19)
    rs=(16, 18)
    imm16=(0, 15)
    sh=(0, 1)
;

attach variables [ rd rs ] [ r0 r1 r2 r3 r4 r5 r6 r7 ];
attach variables [ bank ] [ r6 r7 ];

:add rd, rs, imm16 is mode=0 & op=1 & rd & rs & imm16 { rd = rs + imm16; }
:sub rd, rs, imm16 is mode=1 & op=1 & rd & rs & imm16 { rd = rs - imm16; }

:mode1 is op=2 [ mode=1; globalset(inst_next, mode); ] { }
:mode0 is op=3 [ mode=0; globalset(inst_next, mode); ] { }

:pfx sh is op=4 & sh [ shift=sh; globalset(inst_next, shift); ] { }
:shl rd, rs, shift is op=5 & rd & rs { rd = rs << shift; }
:lo is op=7 & shift<2 { }
:hi is op=7 & shift>=2 { }

SRC: rs is width=0 & rs { export rs; }
SRC: "#"^imm16 is width=1 & imm16 { export *[const]:4 imm16; }
:mov rd, SRC is op=6 & rd & imm_flag & SRC [ width=imm_flag; ] { rd = SRC; }

:inc bank is op=8 & bank { bank = bank + 1; }

Dest: imm16 is imm16 { export *:4 imm16; }
:jmp Dest is op=9 & Dest { goto Dest; }
:jm1 Dest is op=10 & Dest & imm16 [ target = imm16; mode=1; globalset(target, mode); ] { goto Dest; }
:jt1 Dest is op=11 & Dest [ mode=1; globalset(Dest, mode); ] { goto Dest; }

Rel: reloc is imm16 [ reloc = inst_next + imm16; ] { export *:4 reloc; }
:jr1 Rel is op=12 & Rel [ mode=1; globalset(Rel, mode); ] { goto Rel; }

:ms1 SRC is op=13 & imm_flag & SRC [ width=imm_flag; mode=1; globalset(SRC, mode); ] { }
:re1 is op=14 & imm16 [ t = imm16; mode=1; globalset(t, mode); t = 0; ] { }
