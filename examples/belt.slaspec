# A Mill-like belt machine. Instructions do not name destination registers:
# every result "drops" onto the front of the belt (b0) and pushes the older
# values one position back, the oldest falling off the end. Operands name a
# belt position, so the same value is b0 right after it is produced, b1 after
# the next drop, and so on.
#
#   [op:6] [x:4] [y:4] [z:4] [w:4] [v:4] [...:6]    32-bit instructions, big endian
#   [op:6] [x:4] [imm:18]                           immediate forms
#
#   con imm             drop a sign extended 18-bit constant
#   conw imm32          drop a 32-bit constant from the following word
#   add/sub/mul/and/or/xor/shr/shl x, y
#   addi/andi/xori/shri x, imm
#   eql x, y            drop 1 if x == y, else 0
#   ld x, ldb x         drop the word / zero extended byte at address x
#   mov x               drop a copy of x
#   conform x, y, ...   drop copies of 2 to 5 values so that x ends up in b0, y in b1, ...
#   divu x, y           drop x / y, then x % y (two drops)
#   st x, y             store y at address x (no drop)
#   br/brz x, target    branch when x != 0 / x == 0 (no drop)
#   jmp target
#   out x               user defined output (no drop)
#   nop

define endian=big;
define alignment=4;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x00 size=4 [
    b0 b1 b2  b3  b4  b5  b6  b7
    b8 b9 b10 b11 b12 b13 b14 b15
];

define pcodeop out;

define token instr(32)
    op=(26, 31)
    x=(22, 25)
    y=(18, 21)
    z=(14, 17)
    w=(10, 13)
    v=(6, 9)
    count=(0, 2)
    imm18=(0, 17) signed
    rel18=(0, 17) signed
;

define token literal(32)
    imm32=(0, 31)
;

attach variables [ x y z w v ] [
    b0 b1 b2  b3  b4  b5  b6  b7
    b8 b9 b10 b11 b12 b13 b14 b15
];

# Drop a value onto the front of the belt
macro drop(value) {
    b15 = b14;
    b14 = b13;
    b13 = b12;
    b12 = b11;
    b11 = b10;
    b10 = b9;
    b9 = b8;
    b8 = b7;
    b7 = b6;
    b6 = b5;
    b5 = b4;
    b4 = b3;
    b3 = b2;
    b2 = b1;
    b1 = b0;
    b0 = value;
}

TARGET: target is rel18 [ target = inst_next + rel18 * 4; ] { export *:4 target; }

:nop is op=0 { }
:con imm18 is op=1 & imm18 { local result:4 = imm18; drop(result); }
:conw imm32 is op=2; imm32 { local result:4 = imm32; drop(result); }

:add x, y is op=3 & x & y { local result:4 = x + y; drop(result); }
:sub x, y is op=4 & x & y { local result:4 = x - y; drop(result); }
:mul x, y is op=5 & x & y { local result:4 = x * y; drop(result); }
:and x, y is op=6 & x & y { local result:4 = x & y; drop(result); }
:or x, y  is op=7 & x & y { local result:4 = x | y; drop(result); }
:xor x, y is op=8 & x & y { local result:4 = x ^ y; drop(result); }
:shr x, y is op=9 & x & y { local result:4 = x >> y; drop(result); }
:shl x, y is op=10 & x & y { local result:4 = x << y; drop(result); }
:eql x, y is op=11 & x & y { local result:4 = zext(x == y); drop(result); }

:addi x, imm18 is op=12 & x & imm18 { local result:4 = x + imm18; drop(result); }
:andi x, imm18 is op=13 & x & imm18 { local result:4 = x & imm18; drop(result); }
:xori x, imm18 is op=14 & x & imm18 { local result:4 = x ^ imm18; drop(result); }
:shri x, imm18 is op=15 & x & imm18 { local result:4 = x >> imm18; drop(result); }

:ld x  is op=16 & x { local result:4 = *:4 x; drop(result); }
:ldb x is op=17 & x { local result:4 = zext(*:1 x); drop(result); }
:st x, y is op=18 & x & y { *:4 x = y; }

:mov x is op=20 & x { local result:4 = x; drop(result); }

:conform x, y is op=21 & count=2 & x & y {
    local a:4 = x; local b:4 = y;
    drop(b); drop(a);
}
:conform x, y, z is op=21 & count=3 & x & y & z {
    local a:4 = x; local b:4 = y; local c:4 = z;
    drop(c); drop(b); drop(a);
}
:conform x, y, z, w is op=21 & count=4 & x & y & z & w {
    local a:4 = x; local b:4 = y; local c:4 = z; local d:4 = w;
    drop(d); drop(c); drop(b); drop(a);
}
:conform x, y, z, w, v is op=21 & count=5 & x & y & z & w & v {
    local a:4 = x; local b:4 = y; local c:4 = z; local d:4 = w; local e:4 = v;
    drop(e); drop(d); drop(c); drop(b); drop(a);
}

:divu x, y is op=22 & x & y {
    local quotient:4 = x / y;
    local remainder:4 = x % y;
    drop(quotient);
    drop(remainder);
}

:br x, TARGET  is op=23 & x & TARGET { if (x != 0) goto TARGET; }
:brz x, TARGET is op=24 & x & TARGET { if (x == 0) goto TARGET; }
:jmp TARGET    is op=25 & TARGET { goto TARGET; }
:out x is op=26 & x { out(x); }
